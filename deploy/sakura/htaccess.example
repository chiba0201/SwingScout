# SwingScout 用 .htaccess の例（さくらのレンタルサーバー / Apache）
# dist/ をアップロードしたディレクトリに「.htaccess」という名前で置く。
# 500エラーになった場合は、該当ブロックをコメントアウトして切り分けてください。

# ディレクトリ一覧を表示しない
Options -Indexes

# JSON の MIME タイプ
AddType application/json .json

<IfModule mod_headers.c>
  # データJSONは毎回サーバーに更新確認させる（data/ だけ差し替える運用のため）
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # index.html も更新確認させる（新しいビルドのJS/CSSを確実に読ませる）
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ファイル名にハッシュが付いたアセットは長期キャッシュ
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
</IfModule>

# --- Basic 認証（任意・推奨） -------------------------------------------
# コントロールパネルの「アクセス制限」機能を使うか、以下を有効にする。
# .htpasswd は公開ディレクトリ（www）の外に置くこと。
#
# AuthType Basic
# AuthName "SwingScout"
# AuthUserFile /home/<アカウント名>/.htpasswd
# Require valid-user
