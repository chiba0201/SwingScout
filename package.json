{
  "name": "swingscout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "日本株スイング候補のスクリーニングと週次作戦レポート生成（静的サイト + ローカルCLI）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:mock": "tsx scripts/build-data.ts --provider mock --out data/mock-candidates.json",
    "data:watchlist": "tsx scripts/build-data.ts --provider watchlist",
    "data:favorites": "tsx scripts/build-data.ts --provider watchlist --out data/favorites.json --label お気に入り監視 --no-manifest",
    "data:universe": "tsx scripts/build-data.ts --provider universe",
    "data:build": "tsx scripts/build-data.ts",
    "prices:yahoo": "tsx scripts/fetch-yahoo-prices.ts",
    "market:from-today": "tsx scripts/sync-market-from-today.ts",
    "report": "tsx scripts/generate-report.ts",
    "today:check": "tsx scripts/check-today.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
